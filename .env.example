# Copiez ce fichier en .env pour surcharger les valeurs par defaut.
# En developpement, docker-compose fonctionne SANS .env : tout a un defaut.
# En production, changez absolument JWT_SECRET et tous les mots de passe.

POSTGRES_PASSWORD=postgres
API_DB_PASSWORD=api_secret
SUPERVISEUR_DB_PASSWORD=super_secret

MONGO_USER=casino
MONGO_PASSWORD=casino

JWT_SECRET=dev-secret-a-changer-en-production
